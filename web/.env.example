# Copy to .env.local only if you need to override a default.
# NEVER put a secret in a VITE_* variable: every VITE_* value is published in the browser bundle.
# The YouTube API key belongs to the backend only (YOUTUBE_API_KEY in the repo-root .env).

# Optional. Absolute http(s) URL of the TrendRadar backend, for example http://localhost:3000.
# Leave empty to use the same origin; in development the Vite dev server proxies /api to http://localhost:3000.
VITE_API_BASE=
